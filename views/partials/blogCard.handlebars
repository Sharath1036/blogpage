<div class="col-lg-4 card border-0 bg-transparent mt-3">
  <img class="card-img-top mx-auto d-block" src="{{imgSrc coverImage}}" alt="{{title}}" loading="lazy"
    style="height: 200px; object-fit:cover;" />
  <div class="card-body text-left p-0">
    <div class="h6 pt-3"><a href="{{categoryPath category}}" class="font-weight-normal">{{categoryLabel category}}</a></div>
    <div class="card-title h4 text-white">{{title}}</div>
    <div class="card-text">
      <p style="font-size: 18px;">{{excerpt}}</p>
    </div>
    <div class="text-center">
      <a class="text-white" href="/{{slug}}">
        <button type="button" class="btn w-100 mb-4 btn-outline-light">READ FULL BLOG</button></a>
    </div>
  </div>
</div>
