<div class="container admin">
  <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <div class="h2 text-white mb-2">{{#if isEdit}}Edit blog{{else}}New blog{{/if}}</div>
    <a class="btn btn-outline-light" href="/admin">← Dashboard</a>
  </div>

  {{#if errors.length}}
  <div class="alert alert-danger"><ul class="mb-0 pl-3">{{#each errors}}<li>{{this}}</li>{{/each}}</ul></div>
  {{/if}}

  <form id="blog-form" method="post" enctype="multipart/form-data"
        action="{{#if isEdit}}/admin/blogs/{{blog._id}}{{else}}/admin/blogs{{/if}}">
    <input type="hidden" name="contentFormat" id="contentFormat" value="{{#if blog.contentFormat}}{{blog.contentFormat}}{{else}}markdown{{/if}}">

    <div class="form-row">
      <div class="form-group col-md-8">
        <label for="title">Title *</label>
        <input class="form-control" id="title" name="title" value="{{blog.title}}" required maxlength="200">
      </div>
      <div class="form-group col-md-4">
        <label for="category">Section *</label>
        <select class="form-control" id="category" name="category">
          {{#each categories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group col-md-8">
        <label for="slug">URL slug <span class="text-muted small">(auto-generated from the title)</span></label>
        <div class="input-group">
          <div class="input-group-prepend"><span class="input-group-text">/</span></div>
          <input class="form-control" id="slug" name="slug" value="{{blog.slug}}" {{#if isEdit}}data-locked="1"{{/if}} pattern="[a-z0-9]+(-[a-z0-9]+)*">
        </div>
      </div>
      <div class="form-group col-md-4">
        <label for="publishedAt">Publish date</label>
        <input class="form-control" type="date" id="publishedAt" name="publishedAt" value="{{publishedDate}}">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group col-md-8">
        <label for="coverImage">Cover image</label>
        <input class="form-control mb-2" id="coverImage" name="coverImage" value="{{blog.coverImage}}"
               placeholder="Image URL, or a filename from /images (e.g. lighthouse.jpg)">
        <input type="file" class="form-control-file" id="coverFile" name="coverFile" accept="image/*">
        <small class="text-muted">Uploading a file replaces the value above. Max 4 MB.</small>
      </div>
      <div class="form-group col-md-4">
        <img id="cover-preview" class="cover-preview" alt="" {{#if blog.coverImage}}src="{{imgSrc blog.coverImage}}"{{/if}}>
      </div>
    </div>

    <div class="form-group">
      <label for="excerpt">Excerpt <span class="text-muted small">(card text on the home page, leave empty to auto-generate)</span></label>
      <textarea class="form-control" id="excerpt" name="excerpt" rows="2" maxlength="400">{{blog.excerpt}}</textarea>
    </div>

    <div class="form-group form-check">
      <input type="checkbox" class="form-check-input" id="featured" name="featured" {{#if blog.featured}}checked{{/if}}>
      <label class="form-check-label" for="featured">Feature on the home page (otherwise the latest post is featured)</label>
    </div>

    <div class="d-flex flex-wrap align-items-end justify-content-between">
      <label for="content" class="mb-1">Content * <span class="text-muted small" id="format-hint"></span></label>
      <div class="editor-toolbar mb-1">
        <button type="button" class="btn btn-sm btn-outline-light" data-md="**|**" title="Bold"><b>B</b></button>
        <button type="button" class="btn btn-sm btn-outline-light" data-md="*|*" title="Italic"><i>I</i></button>
        <button type="button" class="btn btn-sm btn-outline-light" data-md="\n## |" title="Heading">H2</button>
        <button type="button" class="btn btn-sm btn-outline-light" data-md="\n### |" title="Subheading">H3</button>
        <button type="button" class="btn btn-sm btn-outline-light" data-md="[|](https://)" title="Link">Link</button>
        <button type="button" class="btn btn-sm btn-outline-light" data-md="\n- |" title="List">• List</button>
        <button type="button" class="btn btn-sm btn-outline-light" data-md="\n> |" title="Quote">“ ”</button>
        <button type="button" class="btn btn-sm btn-outline-light" data-md="`|`" title="Inline code">&lt;/&gt;</button>
        <label class="btn btn-sm btn-outline-light mb-0" title="Upload an image into the post">
          Image<input type="file" id="inline-image" accept="image/*" hidden>
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-lg-6 mb-3">
        <textarea class="form-control editor" id="content" name="content" rows="24" required
          placeholder="Write in Markdown. Blank line = new paragraph.&#10;&#10;## A heading&#10;&#10;Some **bold** text and a [link](https://example.com).&#10;&#10;- bullet&#10;- points">{{blog.content}}</textarea>
      </div>
      <div class="col-lg-6 mb-3">
        <div class="preview-wrap">
          <div class="preview-meta" id="stats">0 words · 1 min read</div>
          <div class="preview blog-content" id="preview"><p class="text-muted">Live preview appears here.</p></div>
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-end mb-5">
      <a class="btn btn-outline-light mr-2" href="/admin">Cancel</a>
      <button class="btn btn-light" type="submit">{{#if isEdit}}Save changes{{else}}Publish{{/if}}</button>
    </div>
  </form>
</div>

<script>window.WORDS_PER_MINUTE = {{wordsPerMinute}};</script>
<script src="/js/admin-editor.js"></script>
